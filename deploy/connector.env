# Docker Connector 服务配置
# 安装位置: /etc/docker-connector/connector.env
#
# 修改后执行: systemctl restart docker-connector

# UDP 隧道端口（需与 Desktop 端 config 一致）
CONNECTOR_PORT=2521

# 虚拟网络地址（需与 Desktop 端 config 一致）
# 格式: IP/掩码，例如 192.168.251.1/24
CONNECTOR_ADDR=192.168.252.1/24

# Desktop 端地址（macOS 宿主机）
# Lima VM 中通常为 host.lima.internal
# Docker Desktop 中通常为 host.docker.internal
CONNECTOR_HOST=host.lima.internal

# VM HTTP API 端口（Dashboard 反向代理目标）
CONNECTOR_HTTP_PORT=2522
